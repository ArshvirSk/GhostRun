{
  "expo": {
    "name": "GhostRun",
    "slug": "ghostrun",
    "version": "2.9.23",
    "orientation": "portrait",
    "scheme": "ghost-run",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#101014",
      "dark": {
        "image": "./assets/splash-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#101014"
      }
    },
    "android": {
      "package": "com.ghostrun.app",
      "versionCode": 38,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ghostrun.app",
              "pathPrefix": "/join"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.ghostrun.app",
      "buildNumber": "12",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "GhostRun uses your location to track game boundaries, objectives, and radar pings during live tactical operations.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "GhostRun tracks background location during active matches to alert you via haptics when opponents are near while your screen is off.",
        "NSLocationAlwaysUsageDescription": "GhostRun tracks background location during active matches to keep you in sync with your squad.",
        "NSMotionUsageDescription": "GhostRun measures pedometer and acceleration data to detect authentic foot sprinting and penalize vehicle transport.",
        "NSCameraUsageDescription": "GhostRun uses your camera to scan squad and match join QR codes.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"]
      },
      "associatedDomains": ["applinks:ghostrun.app", "webcredentials:ghostrun.app"]
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GhostRun uses your location to show your position and, during a game, update your team.",
          "locationAlwaysAndWhenInUsePermission": "GhostRun uses your location during a game, including when the screen is off.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications",
      "expo-sharing",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "GhostRun needs camera access to scan runner QR codes for QR Tagging."
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin",
      "expo-web-browser"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a288c4a4-7fec-4449-a4db-a30545627148"
      }
    },
    "owner": "arshvirsk"
  }
}
